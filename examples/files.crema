# ファイルの読み書き

"crema-demo.txt" -> path

# 書き込み (上書き) と追記
"first line\n" path write-file
"second line\n" path append-file
1 3 [ "line #{}\n" swap 1 pack format path append-file ] for

# 存在確認
path file-exists? [ "file exists: " path + print ] when

# 全体を読む
"--- read-file ---" print
path read-file write

# 行ごとに読む
"--- read-lines ---" print
path read-lines [ -> l  "> " l + print ] each
"total lines: " path read-lines len str + print

# 後片付け
path delete-file
path file-exists? [ "deleted: " path + print ] unless
